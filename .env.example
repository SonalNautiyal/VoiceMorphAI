# ---- REQUIRED: Fish Audio API key (get one at https://fish.audio) ----
FISH_API_KEY=paste_your_key_here

# ---- Models (defaults shown; the brief requires drama-3) ----
TTS_MODEL=drama-3
STT_MODEL=transcribe-1-pro

# ---- Optional limits & tuning ----
MAX_UPLOAD_MB=100
MAX_DURATION_S=300
# Gently time-stretch generated audio when it doesn't fit the video length.
STRETCH_ENABLED=1
# Warn in the UI when generated words match the source transcript worse than this.
VERIFY_SIMILARITY_WARN=0.85
